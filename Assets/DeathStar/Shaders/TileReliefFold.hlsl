// Generated by DeathStar.EditorTools.ReliefFold (tools/tile-lab.sh closeup part=fold): the armour carving's average
// effect, measured over 1500 points of random faces, for TileSurface to keep once the plates have sunk.
#ifndef DEATHSTAR_TILE_RELIEF_FOLD_INCLUDED
#define DEATHSTAR_TILE_RELIEF_FOLD_INCLUDED
static const float ReliefFoldElevation[10] = {2, 5, 10, 15, 20, 30, 45, 60, 75, 90};   // degrees
static const float ReliefFoldSun[10] = {0.321, 0.532, 0.707, 0.772, 0.807, 0.878, 0.910, 0.928, 0.964, 1.000};   // sun visibility
static const float ReliefFoldCavity = 0.887;
static const float ReliefFoldAlbedo = 0.979;
static const float ReliefFoldSpread = 0.044;   // share of steps: roughness
float ReliefFoldSunAt(float degrees)
{
    if (degrees <= ReliefFoldElevation[0]) return ReliefFoldSun[0] * saturate(degrees / ReliefFoldElevation[0]);
    [unroll] for (int i = 1; i < 10; i++)
        if (degrees <= ReliefFoldElevation[i])
            return lerp(ReliefFoldSun[i - 1], ReliefFoldSun[i], (degrees - ReliefFoldElevation[i - 1]) / (ReliefFoldElevation[i] - ReliefFoldElevation[i - 1]));
    return ReliefFoldSun[9];
}
#endif
